{
  "name": "btp-deploy-doctor-vscode",
  "displayName": "Deploy Doctor for SAP BTP",
  "description": "Catches SAP BTP / CAP deployment mistakes in mta.yaml, package.json, xs-security.json and Fiori apps, fixes them in one click, and explains failed cf deploy logs and 401/403 errors.",
  "version": "0.2.1",
  "publisher": "HavisunTechnologies",
  "license": "Apache-2.0",
  "author": {
    "name": "HAVISUN Technologies Inc.",
    "url": "https://www.havisun.com"
  },
  "homepage": "https://www.havisun.com/tools/btp-deploy-doctor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/havisun-tech/btp-deploy-doctor.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/havisun-tech/btp-deploy-doctor/issues"
  },
  "icon": "images/icon.png",
  "preview": true,
  "galleryBanner": {
    "color": "#0a3d91",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "sap",
    "btp",
    "cap",
    "cloud foundry",
    "mta",
    "fiori",
    "deploy doctor",
    "xsuaa",
    "xs-security"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/mta.yaml",
    "workspaceContains:**/mta.yml",
    "workspaceContains:**/.cdsrc.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "btpDoctor.check",
        "title": "Check Project",
        "category": "BTP Doctor"
      },
      {
        "command": "btpDoctor.fixAll",
        "title": "Fix All Auto-fixable Problems",
        "category": "BTP Doctor"
      },
      {
        "command": "btpDoctor.diagnoseLog",
        "title": "Explain Log in Editor (or Selection)",
        "category": "BTP Doctor"
      },
      {
        "command": "btpDoctor.diagnoseFile",
        "title": "Explain Log File...",
        "category": "BTP Doctor"
      },
      {
        "command": "btpDoctor.diagnoseApp",
        "title": "Explain Cloud Foundry App Logs...",
        "category": "BTP Doctor"
      },
      {
        "command": "btpDoctor.diagnoseMtaOp",
        "title": "Explain MTA Deploy Operation...",
        "category": "BTP Doctor"
      },
      {
        "command": "btpDoctor.applyFix",
        "title": "Apply Fix",
        "category": "BTP Doctor"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "btpDoctor.diagnoseLog",
          "when": "editorHasSelection",
          "group": "btpDoctor"
        }
      ],
      "commandPalette": [
        {
          "command": "btpDoctor.applyFix",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Deploy Doctor for SAP BTP",
      "properties": {
        "btpDoctor.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-check the project when mta.yaml, package.json, .cdsrc.json, xs-security.json, a .cds file or another checked file is saved."
        },
        "btpDoctor.cfPath": {
          "type": "string",
          "default": "cf",
          "description": "Path to the Cloud Foundry CLI, used to fetch logs."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --main-fields=module,main --format=cjs --target=node18 --external:vscode --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "btp-deploy-doctor": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.85.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
